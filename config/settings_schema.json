[
  {
    "name": "theme_info",
    "theme_name": "HomeStage",
    "theme_version": "0.1.0",
    "theme_author": "Theme Lab",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "big_shoulders_n8",
        "label": "t:labels.display_font",
        "info": "t:info.display_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "schibsted_grotesk_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 32
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.gallery"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#000000",
        "label": "t:labels.ink"
      }
    ]
  }
]
