{%- assign selected_variant = product.selected_or_first_available_variant -%}
<product-page
  class="pdp"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ selected_variant.id }}"
  style="--pdp-gap: {{ section.settings.gap }}px;"
>
  <script type="application/json" data-variants>
    {{ product.variants | json }}
  </script>
  <div class="pdp__grid">
    {% content_for 'blocks' %}
  </div>
</product-page>

{% stylesheet %}
  .pdp {
    display: block;
    padding-block: var(--space-6) var(--space-9);
  }

  .pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 989px) {
    .pdp__grid > .product-column {
      display: contents;
    }

    .pdp__grid [data-pdp] {
      order: 6;
    }

    .pdp__grid [data-pdp="title"] {
      order: 1;
    }

    .pdp__grid [data-pdp="canvas"] {
      order: 2;
    }

    .pdp__grid [data-pdp="fabrics"] {
      order: 3;
    }

    .pdp__grid [data-pdp="price"] {
      order: 4;
    }

    .pdp__grid [data-pdp="buy"] {
      order: 5;
    }
  }

  @media (min-width: 990px) {
    .pdp__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: var(--pdp-gap);
      align-items: start;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductPage extends HTMLElement {
    connectedCallback() {
      this.variants = JSON.parse(this.querySelector('[data-variants]').textContent);
      this.variant = this.variants.find((v) => String(v.id) === this.dataset.variantId) || this.variants[0];
    }

    /** Select a variant by its option values; every block listens for `product:variant`. */
    selectOptions(options) {
      const variant = this.variants.find((v) => v.options.every((value, i) => value === options[i]));
      if (!variant || variant.id === this.variant.id) return;
      this.variant = variant;
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);
      this.dispatchEvent(new CustomEvent('product:variant', { detail: { variant }, bubbles: false }));
    }
  }

  if (!customElements.get('product-page')) customElements.define('product-page', ProductPage);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "tag": "section",
  "class": "pdp-section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.column_gap",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
