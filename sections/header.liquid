<header class="site-header">
  <a class="site-header__name display" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

  <nav class="site-header__menu" aria-label="{{ 'general.menu' | t }}">
    {%- for link in section.settings.menu.links -%}
      <a
        class="caption"
        href="{{ link.url }}"
        {% if link.current %}
          aria-current="page"
        {% endif %}
      >
        {{- link.title | escape -}}
      </a>
    {%- endfor -%}
  </nav>

  <div class="site-header__icons">
    {%- if shop.customer_accounts_enabled -%}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {%- endif -%}

    <a class="site-header__cart" href="{{ routes.cart_url }}">
      <span class="visually-hidden">{{ 'cart.title' | t }}</span>
      {{ 'icon-cart.svg' | inline_asset_content }}
      {%- if cart.item_count > 0 -%}
        <span class="site-header__count numerals">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
  </div>
</header>

{% stylesheet %}
  .site-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-6);
    min-height: 4.5rem;
    border-bottom: var(--rule) solid var(--ink);
  }

  .site-header__name {
    font-size: 2rem;
    text-decoration: none;
  }

  .site-header__menu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .site-header__menu a {
    text-decoration: none;
    padding-block: var(--space-2);
  }

  .site-header__menu a[aria-current='page'],
  .site-header__menu a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--rule);
    text-underline-offset: 0.45em;
  }

  .site-header__icons {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .site-header__icons svg {
    width: 1.75rem;
  }

  .site-header__cart {
    position: relative;
    display: flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .site-header__count {
    position: absolute;
    top: 0;
    right: -0.25rem;
    min-width: 1.25rem;
    padding: 0 0.25rem;
    background: var(--ink);
    color: var(--gallery);
    font-size: 0.75rem;
    line-height: 1.25rem;
    text-align: center;
  }

  @media (max-width: 749px) {
    .site-header {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3);
    }

    .site-header__menu {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
